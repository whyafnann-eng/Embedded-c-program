#include "main.h"

void stepper_motor(void)
{
    GPIOA->ODR &= ~0x0FU;
    GPIOA->ODR |= (1U << 0);
    HAL_Delay(10);

    GPIOA->ODR &= ~0x0FU;
    GPIOA->ODR |= (1U << 1);
    HAL_Delay(10);

    GPIOA->ODR &= ~0x0FU;
    GPIOA->ODR |= (1U << 2);
    HAL_Delay(10);

    GPIOA->ODR &= ~0x0FU;
    GPIOA->ODR |= (1U << 3);
    HAL_Delay(10);
}

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    while (1)
    {
        stepper_motor();
    }
}
